<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="parking.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2471"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="vehicles" custom_title="0" dock_id="3" table="4,8:mainvehicles"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="accounts" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="69"/><column index="2" value="117"/><column index="3" value="300"/><column index="4" value="88"/><column index="5" value="41"/><column index="6" value="156"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="vehicles" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="65"/><column index="2" value="86"/><column index="3" value="81"/><column index="4" value="79"/><column index="5" value="156"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Register the vehicle (if not already in the system)
INSERT OR IGNORE INTO vehicles (plate_number, vehicle_type) 
VALUES ('XYZ1234', 'Sedan');

-- 2. Mark slot B-01 as occupied in Zone B
UPDATE parking_slots 
SET is_occupied = 1 
WHERE slot_number = 'B-01';

-- 3. Create the active parking session linking vehicle XYZ1234 to slot B-01
INSERT INTO parking_sessions (vehicle_id, slot_id, entry_time)
VALUES (
    (SELECT vehicle_id FROM vehicles WHERE plate_number = 'XYZ1234'),
    (SELECT slot_id FROM parking_slots WHERE slot_number = 'B-01'),
    CURRENT_TIMESTAMP
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
